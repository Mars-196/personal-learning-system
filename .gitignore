# ============================================================
# 根目录 .gitignore
# 覆盖根级与环境相关的忽略项，app/ 子目录的忽略规则见 app/.gitignore
# ============================================================

# 依赖与构建产物
node_modules/
dist/
dist-ssr/
build/
*.local

# 日志
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 环境变量与密钥（永不上传）
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# 编辑器与 IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 操作系统文件
.DS_Store
Thumbs.db
*.tmp

# 测试/覆盖率
coverage/
.nyc_output/